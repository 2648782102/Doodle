{
  "mcpServers": {
    "doodle": {
      "command": "node",
      "args": ["<absolute-path-to>/Doodle/dist/index.js"],
      "env": {
        "DOODLE_WORKSPACE_ROOT": "<absolute-path-to-your-project>",
        "OUTPUT_DIR": "<absolute-path-to>/Doodle/output",
        "PREVIEW_PORT": "3399",
        "LOG_LEVEL": "info"
      }
    }
  }
}
