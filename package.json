{
  "name": "ai-draw-mcp",
  "version": "0.4.0",
  "description": "A simple shared infinite canvas where people and AI draw objects, arrows, and short notes through MCP.",
  "type": "module",
  "bin": {
    "ai-draw-mcp": "dist/index.js"
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2648782102/ai-draw-mcp.git"
  },
  "homepage": "https://github.com/2648782102/ai-draw-mcp#readme",
  "bugs": {
    "url": "https://github.com/2648782102/ai-draw-mcp/issues"
  },
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "prepublishOnly": "npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run build && npm test && npm run test:examples && npm run repo:check && npm run doctor && npm pack --dry-run",
    "test:examples": "node --check examples/board-client.mjs",
    "doctor": "node scripts/doctor.mjs",
    "repo:check": "node scripts/repo-check.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai",
    "canvas",
    "whiteboard",
    "drawing",
    "visualization",
    "developer-tools",
    "local-first",
    "typescript"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "express": "^5.3.0",
    "ws": "^8.22.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "@hono/node-server": "^2.1.6",
    "esbuild": "^0.28.2",
    "fast-uri": "^4.2.3",
    "hono": "^4.13.17",
    "ip-address": "^10.7.6",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.12",
    "source-map-js": "^1.2.2",
    "tinypool": "^2.2.0",
    "vite": "^7.3.7"
  }
}
