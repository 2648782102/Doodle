[
  {
    "id": "seq/release-pipeline",
    "prompt": "画一个发布流水线：提交 → 构建 → 测试 → 部署 → 监控",
    "expect": {
      "kind": "sequence",
      "ordered": true,
      "nodes": [
        "提交",
        "构建",
        "测试",
